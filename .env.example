# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TGTOKEN=your_telegram_bot_token_here

# Legacy token name (same as TGTOKEN, kept for backwards compatibility)
BOT_TOKEN=your_telegram_bot_token_here

# Database Configuration
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Logging Configuration
# Directory where log files will be stored
LOGPATH=/path/to/logs

# Telegram Chat IDs for logging and feedback
# Use negative IDs for groups/channels
LOG_CHAT_ID=-1234567890
FEEDBACK_CHAT_ID=-1234567890
